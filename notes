# Basic commands to compile code and generate necessary output files
avr-gcc -Os -mmcu=atmega328p -c uart_test.c 
avr-gcc -mmcu=atmega328p -o uart_test.elf uart_test.o
avr-objcopy -j .text -j .data -O ihex uart_test.elf uart_test.hex
sudo avrdude -c gpio -p atmega328p -v -U flash:w:./uart_test.hex


# Command to check the connection with atmega chip
sudo avrdude -c gpio -p atmega328p -v


# Location of avrdude conf file
/etc/avrdude.conf
